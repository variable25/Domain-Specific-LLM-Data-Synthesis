# Copy to .env (gitignored). Never commit real values.
DATABASE_URL=postgresql+psycopg://sdrag:sdrag@localhost:5433/sdrag
EMBED_MODEL=BAAI/bge-base-en-v1.5
DATA_DIR=data
# LLM: openai (paid; use a project key with a budget limit) or groq (free)
LLM_PROVIDER=openai
MAX_ANSWER_TOKENS=1024
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# calls stop once data/openai_spend.json reaches this; prices are USD per 1M tokens
OPENAI_BUDGET_USD=2.0
OPENAI_PRICE_IN=0.25
OPENAI_PRICE_OUT=2.0
# Free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TOP_K=5
